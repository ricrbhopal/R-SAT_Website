generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}






model Admin {
  id         String   @id @default(uuid())
  student_id String?
  reffer_id  String?
  username   String   @unique
  phone      String   @unique
  password   String
  role       String   @default("caller")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  referralsMade Referred[]


  @@map("adminAuth") // Map to the correct table name
}




model Otp {
  id        String   @id @default(uuid())
  otpfor    String
  otp       String
  type      String
  createdAt DateTime @default(now())
}





model Student {
  id         String   @id @default(uuid())
  student_ID String   @unique
  fullName   String
  phoneNo    String
  mail_ID    String?
  college    String
  branch     String
  year       String
  dob        DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // Relation back to support queries
  supportQueries SupportQuery[]

  admitCards AdmitCard[] 
  referredRecords  Referred[] @relation("ReferredStudentRelation")
  referrals        Referred[]  // student id referrals
  results          Result[]    // add results relation

}





model AdmitCard {
  id             String    @id @default(uuid())
  studentId      String    @unique
  ApplicantName  String?
  RSAT           String
  status         String    @default("Inactive")
  issuedDate     DateTime?
  venue          String?
  examDate       DateTime?
  examTime       String?
  ReportingTime  String?
  college        String?
  branch         String?
  year           String?
  contact        String?
  emailSent      Boolean?  @default(false)
  emailSentAt    DateTime?
  emailError     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id])
}





model Demo {
  id          String   @id @default(uuid())
  studentName String?
  email       String?
  phone       String?
  collegeName String?
  year        String
  demoSlot    String
  type        String   @default("offline") // store "online" or "offline"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}





model SupportQuery {
  id            String   @id @default(uuid())
  studentId     String?
  subject       String?
  description   String?
  status        String    @default("open") // open | in_progress | resolved
  responses     String?   // store JSON string: e.g. JSON.stringify([...])
  imageUrl      String?
  imagePublicId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relation with Student model
  student       Student?  @relation(fields: [studentId], references: [id])

  @@map("SupportQuery")
}





model Referred {
  id               String   @id @default(uuid())

  // student who referred someone (optional)
  studentId        String?
  student          Student? @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // caller/admin who referred
  callerId         String?
  caller           Admin?   @relation(fields: [callerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // referrer student unique string ID (RICR-RSR-0002 etc.)
  referrerStudentID String?

  // invited student (after registration)
  referredStudentId String?
  referredStudent   Student? @relation("ReferredStudentRelation", fields: [referredStudentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // invited user's prefilled details
  referredName      String?  @default("")
  referredEmail     String?  @default("")
  referredPhone     String?  @default("")
  collegeName       String?  @default("")
  year              String?  @default("")

  // unique referral code
  refCode           String?   @unique

  referredDate      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("Referred")
}





model DemoSlot {
  id           String   @id @default(uuid())
  slotTime     String   @unique // e.g., "2025-12-10 10:00 AM"
  capacity     Int      @default(10) // maximum students for this slot
  booked       Int      @default(0) // current bookings
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("DemoSlot")
}





model Result {
  id               String   @id @default(uuid())

  // Required reference to Student (same as mongoose required: true)
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Optional custom student identifier
  student_ID_custom String?  

  // Marks / numeric fields
  A                Float
  B                Float
  C                Float
  D                Float

  total            Float
  percentage       Float
  scholarShip      Float

  // boolean flag
  check            Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("Result")
}




